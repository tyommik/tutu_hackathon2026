# ── Серверные переменные (нужны только в рантайме) ───────────────────────
# Адрес MCP-сервера Туту (авторизация не нужна)
TUTU_MCP_URL=https://mcp.tutu.ru/mcp

# TTL кэша поисков в мс. Обычный режим — 10 минут.
# На демо-день ставим 24 часа и прогреваем кэш: npm run warm
TROPA_CACHE_TTL_MS=600000

# К какому интерфейсу привязать порт 3000.
# 127.0.0.1 — по умолчанию: наружу пускает nginx хоста, он же держит TLS.
# 0.0.0.0 — порт виден из сети напрямую, мимо nginx и без TLS.
#           Годится для демо в доверенной сети, не для интернета.
TROPA_BIND=127.0.0.1

# ИИ-копилот (опционально — без ключа ручной режим работает полностью)
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Модель для подбора хабов при разбивке плеча (по умолчанию openai/gpt-4o-mini —
# быстрая мелкая; reasoning-модели сюда не ставить, они не укладываются в таймаут)
# TROPA_HUB_MODEL=openai/gpt-4o-mini

# ── Клиентские переменные (ВШИВАЮТСЯ В БАНДЛ ПРИ СБОРКЕ) ─────────────────
# Их читает docker compose при build; менять их в рантайме бесполезно —
# нужна пересборка образа.
# Подложка карты отелей. Без неё карта рисует схему с кольцами расстояний
# и работает офлайн. Ключ: https://cloud.maptiler.com/account/keys
# Тайлы 256 px обязательны — это сегмент /256/ в пути.
NEXT_PUBLIC_TILES_URL=https://api.maptiler.com/maps/dataviz/256/{z}/{x}/{y}.png?key=ВАШ_КЛЮЧ
NEXT_PUBLIC_TILES_URL_DARK=https://api.maptiler.com/maps/dataviz-dark/256/{z}/{x}/{y}.png?key=ВАШ_КЛЮЧ
# Атрибуция обязательна по условиям MapTiler — рисуется в углу карты
NEXT_PUBLIC_TILES_ATTRIBUTION=© MapTiler © OpenStreetMap
